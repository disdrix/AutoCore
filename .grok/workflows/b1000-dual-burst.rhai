fn split_csv(s) {
    let out = [];
    let cur = "";
    let i = 0;
    let n = s.len();
    while i < n {
        let ch = s[i];
        if ch == "," {
            out.push(cur);
            cur = "";
        } else {
            cur += ch;
        }
        i += 1;
    }
    out.push(cur);
    out
}

fn pad4(n) {
    let s = n.to_string();
    while s.len() < 4 {
        s = "0" + s;
    }
    s
}

let hexes = split_csv(hexes_csv);
phase("Dual");
let n = hexes.len();
log("B1000 dual burst starting; count=" + n.to_string());

let jobs = [];
let i = 0;
while i < n {
    let h = hexes[i];
    let ag = "B1000-" + pad4(i + 1);
    let prompt = "";
    prompt += "OWN-ONLY dual A/B for autoassault.exe VA 0x";
    prompt += h;
    prompt += " only. Ghidra base 0x400000. Do NOT edit other VAs or parent ledgers. ";
    prompt += "Partition WAVE_2026-08-06_b1000_burst_partition_map.md -> ";
    prompt += ag;
    prompt += ". Dual start 2726. Terminal false. Coverage metrics are NOT completion. ";
    prompt += "Use decompile_function + analyze_function_complete + callers/xrefs + read_memory. Write A_aa_";
    prompt += h;
    prompt += "_* and B_aa_";
    prompt += h;
    prompt += "_* duals, real trio+function records, report docs/agents/task-dual-ab-";
    prompt += h;
    prompt += "-b1000-report.md. Infer _Inferred name. Never Runtime Confirmed. Never claim complete. Finish this VA only.";
    jobs.push(#{ prompt: prompt, label: ag, capability_mode: "all", agent_type: "general-purpose" });
    i += 1;
}

log("Launching panel size=" + jobs.len().to_string());
let results = parallel(jobs);
phase("Summarize");
let ok = 0; let fail = 0; let j = 0;
while j < results.len() {
    let r = results[j];
    if r != () && r.success { ok += 1; } else { fail += 1; }
    j += 1;
}
let report = "ok=" + ok.to_string() + " fail=" + fail.to_string() + " total=" + n.to_string() + "\n";
let path = write_scratch_file("b1000_summary.txt", report);
complete(#{ ok: ok, fail: fail, total: n, path: path });
